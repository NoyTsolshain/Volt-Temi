<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/FaqConstrainsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7">

    <!-- Header band with rounded bottom -->
    <View
        android:id="@+id/HeaderBand"
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:background="@drawable/header_band_bg"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Welcome eyebrow -->
    <TextView
        android:id="@+id/WelcomeEyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:elevation="7dp"
        android:text="WELCOME TO VOLT"
        android:textColor="#CCFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.25"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/TitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:elevation="7dp"
        android:text="How to use the app"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        app:layout_constraintTop_toBottomOf="@id/WelcomeEyebrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle / step indicator -->
    <TextView
        android:id="@+id/SubtitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:elevation="7dp"
        android:text="A quick 4-step tour"
        android:textColor="#E6FFFFFF"
        android:textSize="16sp"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@id/TitleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Steps row (cards stretch to equal height; horizontally scrollable on narrow screens) -->
    <HorizontalScrollView
        android:id="@+id/StepsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/HeaderBand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ButtonDivider">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- ========== STEP 1 ========== -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="8dp">

                <LinearLayout
                    android:layout_width="350dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:paddingTop="44dp"
                    android:layout_marginTop="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="To select a destination for navigation, tap the desired location from the list."
                        android:textAlignment="center"
                        android:textSize="20sp"
                        android:textColor="#333333"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="12dp" />

                    <ImageView
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/menu_example"
                        android:adjustViewBounds="true"
                        android:contentDescription="Menu Example"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="1dp"
                        android:background="#1F000000"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="You can also select a destination directly from the map by tapping on it."
                        android:textAlignment="center"
                        android:textSize="20sp"
                        android:textColor="#333333"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="12dp" />

                    <ImageView
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/map_example"
                        android:adjustViewBounds="true"
                        android:contentDescription="Map Example" />
                </LinearLayout>

                <!-- Step badge -->
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/step_badge_bg"
                    android:elevation="2dp"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </FrameLayout>

            <!-- Arrow -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="12dp"
                android:src="@drawable/ic_arrow_right"
                android:alpha="0.55"
                android:contentDescription="Arrow" />

            <!-- ========== STEP 2 ========== -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="8dp">

                <LinearLayout
                    android:layout_width="350dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:paddingTop="44dp"
                    android:layout_marginTop="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="After tapping a destination, a content panel will open with information about it. You can choose to navigate directly or add it to your route."
                        android:textAlignment="center"
                        android:textSize="20sp"
                        android:textColor="#333333"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="20dp" />

                    <ImageView
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/content_panel"
                        android:adjustViewBounds="true"
                        android:contentDescription="Content Example" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/step_badge_bg"
                    android:elevation="2dp"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </FrameLayout>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="12dp"
                android:src="@drawable/ic_arrow_right"
                android:alpha="0.55"
                android:contentDescription="Arrow" />

            <!-- ========== STEP 3 ========== -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="8dp">

                <LinearLayout
                    android:layout_width="350dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:paddingTop="44dp"
                    android:layout_marginTop="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="If you've chosen a route, a list of destinations will appear on the right side. You can rearrange them before starting the trip. Then, press the 'Go!' button at the bottom of the screen to begin your journey."
                        android:textAlignment="center"
                        android:textSize="20sp"
                        android:textColor="#333333"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="20dp" />

                    <ImageView
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/voice_commnads_start_route"
                        android:adjustViewBounds="true"
                        android:contentDescription="Route Example" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/step_badge_bg"
                    android:elevation="2dp"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </FrameLayout>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="12dp"
                android:src="@drawable/ic_arrow_right"
                android:alpha="0.55"
                android:contentDescription="Arrow" />

            <!-- ========== STEP 4 ========== -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="8dp">

                <LinearLayout
                    android:layout_width="350dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:paddingTop="44dp"
                    android:layout_marginTop="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="By tapping the speaker icon, you can give a voice command with the name of the destination you wish to reach."
                        android:textAlignment="center"
                        android:textSize="20sp"
                        android:textColor="#333333"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="24dp" />

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/speaker_icon"
                        android:contentDescription="Speaker Icon"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/tip_pill_bg"
                        android:text="Tip: speak clearly"
                        android:textColor="@color/app_icon"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/step_badge_bg"
                    android:elevation="2dp"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </FrameLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Subtle divider above button -->
    <View
        android:id="@+id/ButtonDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#1F000000"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/FaqScreenButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Continue button (id required by SimpleFAQView) -->
    <Button
        android:id="@+id/FaqScreenButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="240dp"
        android:minHeight="60dp"
        android:paddingHorizontal="36dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/continue_button_bg"
        android:text="@string/continue_button_text"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
